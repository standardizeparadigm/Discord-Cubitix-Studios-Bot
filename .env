# =============================================================
#  CUBITIX STUDIOS BOT - FILE CAU HINH (.env)
#  Dien thong tin cua ban vao ben duoi roi luu lai.
# =============================================================

# ---- BAT BUOC ----
# Token cua bot (lay o Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID ung dung (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID may chu de dang ky lenh gach cheo ngay lap tuc (de trong = dang ky toan cau, cho ~1 gio)
GUILD_ID=

# ---- CO BAN ----
# Ky tu goi lenh, vi du: c  ->  chelp
PREFIX=c

# ID Discord cua chu bot (duoc dung lenh owner, khong bi gioi han cooldown/bao tri)
OWNER_ID=1523863764464697424

# ---- THUONG HIEU ----
BRAND_NAME=Cubitix Studios
EMBED_COLOR=#5865F2
FOOTER_TEXT=Cubitix Studios

# =============================================================
#  CHAO MUNG & TAM BIET THANH VIEN
#  Day chi la GIA TRI MAC DINH. Moi may chu co the tu chinh rieng
#  bang lenh  cwelcome  (chi Quan tri vien dung duoc), va cai dat
#  rieng do se duoc uu tien hon cac dong duoi day.
# =============================================================

# Kenh gui loi chao mung khi co thanh vien moi vao
WELCOME_CHANNEL_ID=

# Kenh gui loi tam biet khi co thanh vien roi di
# (de trong = dung chung kenh voi WELCOME_CHANNEL_ID)
GOODBYE_CHANNEL_ID=

# Bat/tat loi chao mung   (true / false)
WELCOME_ENABLED=true

# Bat/tat loi tam biet     (true / false)
GOODBYE_ENABLED=true

# Bat/tat dem luot moi: hien ai da moi thanh vien moi + tong luot moi cua nguoi do
# LUU Y: bot can quyen "Quan ly may chu" (Manage Server) thi moi dem duoc.
INVITE_TRACKING=true

# ---- NANG CAO ----
# Bat lenh gach cheo (slash command)
ENABLE_SLASH=true

# Trang thai hien thi, cach nhau bang dau ;
# Ho tro: {prefix} {guilds} {users}
ACTIVITIES={prefix}help | Cubitix Studios;{guilds} may chu;{users} thanh vien
