# =============================================================
#  CUBITIX STUDIOS BOT - FILE CẤU HÌNH (.env)
#  Dien thong tin cua ban vao ben duoi roi luu lai.
# =============================================================

# ---- BẮT BUỘC ----
# Token của bot (lấy ở Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=YOUR BOT TOKEN

# ID ứng dụng (Developer Portal > General Information > Application ID)
CLIENT_ID=YOUR BOT ID

# ID máy chủ để đăng ký lệnh gạch chéo ngay lập tức (để trống = đăng ký toàn cầu, chờ ~1 giờ)
GUILD_ID=YOUR SERVER ID

# ---- CƠ BẢN ----
# Ký tự gọi lệnh, ví dụ: c  ->  chelp
PREFIX=c

# ---- THƯƠNG HIỆU ----
BRAND_NAME=YOUR BOT BRAND NAME
EMBED_COLOR=#5865F2
FOOTER_TEXT=YOUR FOOTER TEXT

# =============================================================
#  CHÀO MỪNG & TẠM BIỆT THÀNH VIÊN
#  Đây chỉ là GIÁ TRỊ MẶC ĐỊNH. Mọi máy chủ có thể tự chỉnh riêng
#  bằng lệnh  cwelcome  (chỉ Quản trị viên mới dùng được), và cài đặt
# =============================================================

# Kênh gửi lời chào mừng khi có thành viên mới vào
WELCOME_CHANNEL_ID=YOUR WELCOME CHANNEL

# Kênh gửi lời tạm biệt khi có thành viên rời đi
# (để trống = dùng chung kênh với WELCOME_CHANNEL_ID)
GOODBYE_CHANNEL_ID=YOUR GOODBYE CHANNEL

# Bật/tắt lời chào mừng   (true / false)
WELCOME_ENABLED=true

# Bật/tắt lời tạm biệt     (true / false)
GOODBYE_ENABLED=true

# Bật/tắt đếm lượt mời: hiện ai đã mời thành viên mới + tổng lượt mời của người đó
# LƯU Ý: Bot cần quyền "Quản lý máy chủ" (Manage Server) thì mới đếm được.
INVITE_TRACKING=true

# ---- NÂNG CAO ----
# Bật lệnh gạch chéo (slash command)
ENABLE_SLASH=true

# Trạng thái hiển thị, cách nhau bằng dấu ;
# Hỗ trợ: {prefix} {guilds} {users}
ACTIVITIES={prefix}help | Cubitix Studios;{guilds} may chu;{users} thanh vien
